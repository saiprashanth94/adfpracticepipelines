{
	"name": "pipeline8",
	"properties": {
		"activities": [
			{
				"name": "GetMeta_Sales",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DelimitedText6",
						"type": "DatasetReference",
						"parameters": {
							"param1": {
								"value": "@concat('daily_sales_',pipeline().parameters.pdate, '.csv')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists",
						"size",
						"structure"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Lookup_Controltable",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "GetMeta_Sales",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select allow_load from Sales_Control where business_date = '@{pipeline().parameters.pdate}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable3",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Set Expected_Columns",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_Controltable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "VExpectedClms",
					"value": [
						"store_id",
						"amount",
						"sale_date"
					]
				}
			},
			{
				"name": "Filter_Invalid_Columns",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Set Expected_Columns",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetMeta_Sales').output.structure",
						"type": "Expression"
					},
					"condition": {
						"value": "@not(contains(variables('VExpectedClms'),item().name))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Filter_Invalid_Columns",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(\n    and(activity('GetMeta_Sales').output.exists,\n       greater(activity('GetMeta_Sales').output.size,0)\n    ),\n    and(\n        equals(activity('Lookup_Controltable').output.firstRow.allow_load, 'yes'),\n        equals(length(activity('Filter_Invalid_Columns').output.value), 0)\n    )\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail1",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('validation failed for the daily_sales',pipeline().parameters.pdate, '.csv','posible reasons may be file empty, load not allowd')",
									"type": "Expression"
								},
								"errorCode": {
									"value": "validationsfailed",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DelimitedText6",
									"type": "DatasetReference",
									"parameters": {
										"param1": {
											"value": "@concat('daily_sales_',pipeline().parameters.pdate, '.csv')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "AzureSqlTable4",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"pdate": {
				"type": "string",
				"defaultValue": "'2025-11-18'"
			}
		},
		"variables": {
			"VExpectedClms": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2025-11-20T13:23:21Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}