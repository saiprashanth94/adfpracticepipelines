						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText26",
						"type": "DatasetReference"
					},
					"name": "source3"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText23",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText25",
						"type": "DatasetReference"
					},
					"name": "sink2"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText27",
						"type": "DatasetReference"
					},
					"name": "sink3"
				}
			],
			"transformations": [
				{
					"name": "pivot1"
				},
				{
					"name": "rank1"
				},
				{
					"name": "window1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as short,",
				"          OrderDate as date,",
				"          Region as string,",
				"          Product as string,",
				"          Category as string,",
				"          SalesRep as string,",
				"          Quantity as short,",
				"          UnitPrice as short,",
				"          TotalAmount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          OrderID as short,",
				"          OrderDate as date,",
				"          Region as string,",
				"          Product as string,",
				"          Category as string,",
				"          SalesRep as string,",
				"          Quantity as short,",
				"          UnitPrice as short,",
				"          TotalAmount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          OrderID as short,",
				"          OrderDate as date,",
				"          Region as string,",
				"          Product as string,",
				"          Category as string,",
				"          SalesRep as string,",
				"          Quantity as short,",
				"          UnitPrice as short,",
				"          TotalAmount as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source1 pivot(groupBy(Category),",
				"     pivotBy(Product),",
				"     {total amount} = sum(TotalAmount),",
				"     columnNaming: '$N$V',",
				"     lateral: false) ~> pivot1",
				"source2 rank(desc(Quantity, true),",
				"     output(qRank as long)) ~> rank1",
				"source3 window(over(Region),",
				"     asc(OrderDate, true),",
				"     totalsales = sum(TotalAmount)) ~> window1",
				"pivot1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          name as string,",
				"          url as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"rank1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          name as string,",
				"          url as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink2",
				"window1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          name as string,",
				"          url as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink3"
			]
		}
	}
}