{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText8",
						"type": "DatasetReference"
					},
					"name": "sourceorders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Json3",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "Json4",
						"type": "DatasetReference"
					},
					"name": "sink2"
				},
				{
					"dataset": {
						"referenceName": "Json5",
						"type": "DatasetReference"
					},
					"name": "sink3"
				}
			],
			"transformations": [
				{
					"name": "sort1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select2"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          CustomerID as string,",
				"          CustomerName as string,",
				"          Country as string,",
				"          City as string,",
				"          Product as string,",
				"          Category as string,",
				"          OrderDate as string,",
				"          Quantity as string,",
				"          UnitPrice as string,",
				"          OrderStatus as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceorders",
				"sourceorders sort(desc(CustomerName, true),",
				"     asc(Quantity, true)) ~> sort1",
				"sort1 select(mapColumn(",
				"          CustomerID,",
				"          CustomerName,",
				"          Country,",
				"          CITY = City,",
				"          PRODUCT = Product,",
				"          Category,",
				"          OrderDate,",
				"          OrderID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(Cname1 = upper(CustomerName),",
				"          CITY = lower(CITY)) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          CustomerID,",
				"          Country,",
				"          CITY,",
				"          PRODUCT,",
				"          Category,",
				"          OrderDate,",
				"          OrderID,",
				"          Cname1",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 split(equals(Category, \"Electronics\"),",
				"     equals(Category, \"Accessories\"),",
				"     disjoint: false) ~> split1@(Electronics, Accessories, others)",
				"split1@Electronics sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderID as integer,",
				"          CustomerID as string,",
				"          CustomerName as string,",
				"          Country as string,",
				"          City as string,",
				"          Product as string,",
				"          Category as string,",
				"          OrderDate as string,",
				"          Quantity as integer,",
				"          UnitPrice as integer,",
				"          OrderStatus as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"split1@Accessories sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderID as integer,",
				"          CustomerID as string,",
				"          CustomerName as string,",
				"          Country as string,",
				"          City as string,",
				"          Product as string,",
				"          Category as string,",
				"          OrderDate as string,",
				"          Quantity as integer,",
				"          UnitPrice as integer,",
				"          OrderStatus as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2",
				"split1@others sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OrderID as integer,",
				"          CustomerID as string,",
				"          CustomerName as string,",
				"          Country as string,",
				"          City as string,",
				"          Product as string,",
				"          Category as string,",
				"          OrderDate as string,",
				"          Quantity as integer,",
				"          UnitPrice as integer,",
				"          OrderStatus as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink3"
			]
		}
	}
}